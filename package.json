{
  "name": "make-unitypackage",
  "version": "1.1.2",
  "description": "make unitypackage! (browser compatible)",
  "main": "index.cjs",
  "types": "index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "build": "tsc --noEmit && tsdown"
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "index.mjs",
    "index.d.mts"
  ],
  "keywords": [
    "unity",
    "unitypackage"
  ],
  "author": "narazaka",
  "repository": {
    "url": "https://github.com/Narazaka/make-unitypackage"
  },
  "license": "Zlib",
  "dependencies": {
    "fflate": "^0.8.2",
    "tar-js": "^0.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^25.6.2",
    "@types/tar-js": "^0.3.5",
    "publint": "^0.3.20",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
